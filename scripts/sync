#!/usr/bin/env bash
# Refresh this machine's copy of the shared agent setup. Idempotent; cron it.
#
# - stamps AGENTS.md into ~/.codex/AGENTS.md between its BEGIN/END markers,
#   leaving anything else in the file (e.g. dcvz/hub's hub-host block) alone
# - makes sure ~/.claude/CLAUDE.md imports ~/.codex/AGENTS.md
# - refreshes the Codex plugin marketplace snapshot (Codex has no auto-update;
#   Claude updates the plugin itself once auto-update is enabled for it)
set -euo pipefail

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/dcvz-ai"
if [ -d "$CACHE/.git" ]; then
  git -C "$CACHE" pull -q --ff-only
else
  git clone -q git@github.com:dcvz/ai.git "$CACHE"
fi

mkdir -p "$HOME/.codex" "$HOME/.claude"
touch "$HOME/.codex/AGENTS.md" "$HOME/.claude/CLAUDE.md"
python3 - "$HOME/.codex/AGENTS.md" "$HOME/.claude/CLAUDE.md" "$CACHE/AGENTS.md" <<'PYEOF'
import pathlib, re, sys
dest, claude_md, src = (pathlib.Path(a) for a in sys.argv[1:4])

block = src.read_text().strip()
pat = re.compile(r"<!-- BEGIN standards .*?<!-- END standards -->", re.S)
cur = dest.read_text()
# A lambda, not the string: the block carries backslashes re.sub would eat.
dest.write_text(pat.sub(lambda _: block, cur) if pat.search(cur)
                else (block + "\n\n" + cur.lstrip()).rstrip() + "\n")

IMPORT = "@~/.codex/AGENTS.md"
cm = claude_md.read_text()
if IMPORT not in cm:
    header = ("# Coding standards\n\nShared with Codex. Single source of truth, "
              "do not duplicate the rules here.\n\n" + IMPORT + "\n")
    claude_md.write_text(header + "\n" + cm.lstrip())
PYEOF

command -v codex >/dev/null 2>&1 && codex plugin marketplace upgrade >/dev/null 2>&1 || true
echo "synced $(git -C "$CACHE" rev-parse --short HEAD)"
